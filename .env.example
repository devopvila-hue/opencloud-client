# ============================================================
# OPENCloud Client Portal — Environment Variables
# ============================================================
# Copy to .env.local and fill in. Do NOT commit .env.local.
# ============================================================

# —  — Application —  — # The Client Portal is a pure Presentation Layer.
# It consumes the OPENCloud middleware API at /api/v1/*.
# In development, Vite proxies /api to http://127.0.0.1:3210.
# In production on Netlify, /api/* is served by the same host as
# the SPA (middleware and portal share a domain via reverse proxy).

# —  — Auth —  — # The session cookie (opc_session) is HttpOnly + HMAC-signed
# by the middleware. No client-side env needed for auth flows.

# —  — Analytics (optional) —  — # Set to your analytics ID if you use a provider.
# VITE_ANALYTICS_ID=GA-XXXXXXXXX

# —  — Theme override (optional) —  — # Forces a theme on first load before localStorage kicks in.
# VITE_DEFAULT_THEME=dark

# —  — Netlify build settings (auto-detected) —  — # BUILD_COMMAND: npm run build
# PUBLISH_DIRECTORY: dist
