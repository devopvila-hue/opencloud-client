# ============================================================
# DEPARTIFY Client Portal — Environment Variables
# ============================================================
# Copy to .env.local and fill in. Do NOT commit .env.local.
# ============================================================
#
# Public architecture:
#   - Marketing site:    https://departify.app
#   - Client portal:     https://app.departify.app   (this app)
#   - Backend API:       https://api.departify.app   (consumed via /api/v1/*)
#
# The portal is a pure presentation layer. In development, Vite
# proxies /api to the local middleware. In production on Netlify,
# /api/* is served by api.departify.app via the redirect rule in
# netlify.toml (MUST come before the SPA fallback rule).

# —  — Auth —  — # The session cookie is HttpOnly + HMAC-signed by the
# middleware. No client-side env needed for auth flows.

# —  — Auth redirect (authRedirect.ts) —  — # When the session cookie is missing, RequireAuth redirects
# the user to the login screen. By default the redirect uses
# window.location.origin (same-origin — Netlify SPA).
#
# Set VITE_AUTH_URL only when the login screen lives on a SEPARATE
# origin. Provide the full origin without a trailing slash — the SPA
# appends "/login".
#
# Examples:
#   Development (default — leave unset):
#     window.location.origin → http://localhost:5173/login
#
#   Production (Netlify — leave unset):
#     window.location.origin → https://app.departify.app/login
#
#   Separate-origin production:
#     VITE_AUTH_URL=https://app.example.com
#     → https://app.example.com/login
#
# IMPORTANT: never hardcode URLs in source. Production bundles will
# ship them to real users.
# VITE_AUTH_URL=

# —  — Analytics (optional) —  — # Set to your analytics ID if you use a provider.
# VITE_ANALYTICS_ID=GA-XXXXXXXXX

# —  — Theme override (optional) —  — # Forces a theme on first load before localStorage kicks in.
# VITE_DEFAULT_THEME=dark

# —  — Netlify build settings (auto-detected) —  — # BUILD_COMMAND: npm run build
# PUBLISH_DIRECTORY: dist